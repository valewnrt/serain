# Serain configuration.
#
# Locally: copy this file to `.dev.vars` (gitignored) and fill it in:
#   cp .env.example .dev.vars && chmod 600 .dev.vars
# On the server: the same values live in /etc/serain/serain.env (owned by root,
# readable by the `serain` group), except the variables in the "Local only"
# section at the end. See docs/SETUP.md for every step.
#
# Never commit real values. Never paste them into a chat with a model.
# Values may be quoted ("...") or bare. Empty means "not set".

# -----------------------------------------------------------------------------
# Owner (required unless marked optional)
# -----------------------------------------------------------------------------

# Required. Your first name, the way Serain addresses you and writes about you.
OWNER_NAME=
# Required. Your iMessage phone number in E.164 format (+4915112345678). This is
# the ingress allowlist: no other sender ever reaches the model.
OWNER_PHONE=
# Optional, default `en`. Starting language until Serain has seen how you
# write; Serain then answers in the language you write in. A BCP 47 tag such as
# `en`, `de`, `tr` or `es-MX`.
OWNER_LANGUAGE=en
# Required. IANA time zone you live in, e.g. Europe/Berlin, America/New_York.
# Reminders and calendar entries are computed in it.
OWNER_TIMEZONE=
# Optional. Country you live in, ISO 3166-1 alpha-2 (DE, TR, US, ...). Public
# holidays are built in for DE only so far.
OWNER_COUNTRY=
# Optional, only with OWNER_COUNTRY=DE. German federal state for public holidays
# (BW, BY, BE, BB, HB, HH, HE, MV, NI, NW, RP, SL, SN, ST, SH, TH). Empty:
# nationwide holidays only.
OWNER_REGION=
# Optional. Your town, as the starting point for timetables, weather and
# searches nearby.
OWNER_CITY=

# -----------------------------------------------------------------------------
# iMessage channel: Photon (required)
# -----------------------------------------------------------------------------

# Required. Project ID and secret from your Photon project (iMessage, Free plan).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# -----------------------------------------------------------------------------
# Database: Supabase (required)
# -----------------------------------------------------------------------------

# Required. https://<project-ref>.supabase.co
SUPABASE_URL=
# Required. Secret key (sb_secret_...) from Project Settings > API Keys. Never
# the publishable key, never a legacy service key.
SUPABASE_SECRET_KEY=
# Required. Postgres connection for recurring work, as role `serain_server`.
# Do not write it by hand: `pnpm db:password` sets it here and on the server.
SERAIN_DB_URL=

# -----------------------------------------------------------------------------
# Claude (one of the two; without either, every model call goes through the
# OpenRouter fallback models below, which the prompts are not tuned for)
# -----------------------------------------------------------------------------

# Default. Anthropic API key (sk-ant-api...) from console.anthropic.com. Every
# request is billed. Serain books the cost in `usage_log` and stops paid calls,
# including the chat, at SERAIN_API_BUDGET_USD (see "Budget" below). Its
# figures are list-price estimates, so also set a monthly spend limit in the
# Anthropic Console.
ANTHROPIC_API_KEY=
# Option, for strictly personal use of your own instance at your own risk: the
# token of your own Claude subscription (`claude setup-token`). Never someone
# else's. Costs nothing per request. If both are set, the API key wins and the
# token is ignored.
CLAUDE_CODE_OAUTH_TOKEN=

# -----------------------------------------------------------------------------
# Budget (optional, src/config/limits.ts)
# -----------------------------------------------------------------------------

# Monthly cap in US dollars for everything paid per request: Claude with an API
# key, OpenRouter, Typesafe. At 80 % Serain saves (cheaper models, no heartbeat),
# at 100 % paid calls stop until the first of the month. Default 20.
SERAIN_API_BUDGET_USD=
# Fixed monthly costs outside the API (server, channel), already counted
# against the total cap. Default 0 (free server, Photon Free).
SERAIN_FIXED_COST_USD=
# Total cap, everything included. Default: API cap plus fixed costs.
SERAIN_TOTAL_BUDGET_USD=

# -----------------------------------------------------------------------------
# Optional services
# -----------------------------------------------------------------------------

# Optional. OpenRouter key. Unlocks: fallback model when Claude fails,
# embeddings for semantic memory search (otherwise full-text only), videos
# (Gemini), the hosted voice for spoken replies (Fish Audio, only for languages
# in SPEECH.voices in src/config/models.ts; otherwise the local Piper voice
# speaks), image fallback. Counts against SERAIN_API_BUDGET_USD;
# set a limit on the key itself too.
OPENROUTER_API_KEY=
# Optional. Tavily key. Unlocks the `web_search` tool; fetching single pages
# works without it.
TAVILY_API_KEY=
# Optional. Typesafe key for the browser pilot (`web_browse`). Needs
# SERAIN_CHROME_PATH too. Only public pages are sent to Typesafe.
TYPESAFE_API_KEY=
# Optional. Chrome or Chromium for `web_browse`. On the server
# /usr/local/bin/serain-chromium (installed by deploy/deploy.sh).
SERAIN_CHROME_PATH=
# Optional, default off. `1` lets the sandbox download TikTok, Instagram and X
# videos with yt-dlp for `media_watch`. At your own risk, see README "Legal".
# YouTube works without it (fetched by Google AI Studio, never downloaded).
SERAIN_MEDIA_DOWNLOAD=
# Optional. Healthchecks.io ping URL (contains a secret UUID). Unlocks the
# alarm outside iMessage when the server or the channel is down.
HEALTHCHECKS_PING_URL=

# -----------------------------------------------------------------------------
# Integrations, vault and connections (optional)
# -----------------------------------------------------------------------------

# Optional. 32 bytes base64, created with `pnpm integration key`. Seals mail,
# Google and iCloud credentials in the database. Without it: no integrations.
# Must be identical here and on the server.
SERAIN_INTEGRATION_KEY=
# Optional. Private vault key (P-256, PKCS#8 base64url), created with
# `pnpm web vault-key`. Unlocks logged-in sessions, vault files and
# connections. Must be identical here and on the server. If it is lost, every
# vault entry is lost.
SERAIN_VAULT_KEY=
# Optional. Enable Banking app ID and private key (PEM, base64), written by
# `pnpm connector bank-key <file.pem>`. Unlocks read-only bank access in the
# web interface's Connections tab.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY=
# Optional, needed with the two above. Your bank as Enable Banking lists it
# (`pnpm connector bank-check <search>` prints the exact name) and its country
# (ISO 3166-1, default DE). Only your own accounts, non-commercial use.
ENABLE_BANKING_BANK=
ENABLE_BANKING_COUNTRY=DE
# Optional. Origin of your web interface, e.g. https://serain.example.com
# (https, no path). Needed for the web interface and for connections with a
# fixed redirect URL (bank).
SERAIN_WEB_ORIGIN=

# -----------------------------------------------------------------------------
# Mac companion (optional; set on the server by ./companion/install.sh)
# -----------------------------------------------------------------------------

# Loopback port of the SSH tunnel and the shared token. Both or neither.
SERAIN_COMPANION_PORT=
SERAIN_COMPANION_TOKEN=

# -----------------------------------------------------------------------------
# Runtime (optional; deploy/serain.service sets these on the server)
# -----------------------------------------------------------------------------

# Unix socket of the sandbox helper. Server: /run/serain-sandbox.sock.
# Without it: no `run_code`, no attachments, no voice messages in either
# direction.
SERAIN_SANDBOX_SOCKET=
# Directory of the filter proxy socket used by video downloads.
# Server: /run/serain/media-proxy.
SERAIN_MEDIA_PROXY_DIR=
# The only writable directory in production. Default: current directory.
SERAIN_DATA_DIR=
# debug, info, warn or error. Default: info.
SERAIN_LOG_LEVEL=
# `1` answers every message with an echo instead of the model: tests the
# channel at no cost. Leave empty in production.
SERAIN_ECHO_ONLY=
# Name of the systemd unit the watchdog checks. Default: serain.
SERAIN_SERVICE_NAME=
# Set by systemd itself, never by hand: RUNTIME_DIRECTORY (where the service
# reports whether it is busy, read by deploy/deploy.sh) and LISTEN_FDS (socket
# activation of the sandbox helper).

# -----------------------------------------------------------------------------
# Local only: used by scripts on your machine, never copied to the server
# -----------------------------------------------------------------------------

# SSH target of your server, e.g. root@203.0.113.10. Used by deploy/deploy.sh,
# pnpm db:password and companion/install.sh.
SERAIN_HOST=
# Database password of your Supabase project (the `postgres` role). Used by
# pnpm db:password to set the password of `serain_server`.
SUPABASE_DB_PASSWORD=
# Session pooler host of your Supabase project (Connect > Session pooler),
# e.g. aws-0-eu-central-1.pooler.supabase.com. Used by pnpm db:password.
SUPABASE_POOLER_HOST=
# Supabase personal access token (Account > Access Tokens). Only for the web
# interface: pnpm web db-password. On macOS it may live in the keychain
# instead (service `supabase-serain`, see scripts/dev-vars.ts).
SUPABASE_ACCESS_TOKEN=
# Google OAuth client of type "Desktop app" for `pnpm integration connect google`.
# The server does not need them: they are sealed with the connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web interface on Cloudflare (pnpm web:setup, web:check, web:deploy): API
# token, account ID, and the one email address Cloudflare Access lets in.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
WEB_ACCESS_EMAIL=
# Maintainer only: imprint and privacy notice of serain.si (site/legal.ts).
# Kept here so they never enter the repository; pnpm site:deploy refuses
# without them, pnpm site:dev shows the names instead.
SITE_IMPRINT_STREET=
SITE_IMPRINT_CITY=
SITE_IMPRINT_PHONE=
SITE_IMPRINT_EMAIL=
SITE_IMPRINT_VAT_ID=

# Development only, normally not set:
#   FUZZ_RUNS, FUZZ_SEED        fuzz tests (pnpm fuzz sets FUZZ_RUNS=2000)
#   SERAIN_E2E_SHOTS=<dir>      screenshots from pnpm web:e2e
#   BENCH_OUT, BENCH_TRACE, BENCH_VERBOSE, BENCH_CITY   pnpm browse:bench
#   SERAIN_COMPANION_CONFIG     config file of the Mac companion, on the Mac
#                               (default: its Application Support folder)
# Evals (pnpm eval) ignore OWNER_NAME, OWNER_TIMEZONE and OWNER_LANGUAGE and
# play the fixed persona "Alex" (eval/persona.ts).
# The web interface keeps its own database settings (DATABASE_URL,
# DATABASE_UPSTREAM) in web/.dev.vars, written by pnpm web db-password.
