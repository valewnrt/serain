# Spoken replies of the sandbox (D59). An image of its own, because Piper and
# onnxruntime need glibc and the sandbox image is Alpine (musl). Runs with the
# same flags as every job: --network none, --read-only, --cap-drop ALL, nobody.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir piper-tts==1.3.0
# One Piper voice per language, from rhasspy/piper-voices at the fixed tag
# v1.0.0, stored as /opt/voice/<lang>.onnx (plus .onnx.json). The helper knows
# the same list (VOICES in helper.mjs); a language without a voice here gets
# its reply as text. Each voice is about 63 MB, the ten together about 630 MB.
# Chosen for a clear license of the training data (CC0, CC BY 4.0 or public
# domain) and, where Piper has one, a female voice (decision of 2026-10-08):
#   de  de_DE-kerstin-low      CC0, female, 16 kHz; measured on the Oracle ARM
#                              with two cores: 3.1 s for a sentence of 7.6 s (D59)
#   en  en_US-ljspeech-medium  public domain, female
#   es  es_ES-davefx-medium    CC0, male (the female Spanish voices are NC or unclear)
#   fr  fr_FR-siwis-medium     CC BY 4.0, female
#   it  it_IT-paola-medium     CC0, female
#   nl  nl_BE-nathalie-medium  CC0, female (Flemish)
#   pl  pl_PL-gosia-medium     CC0, female
#   pt  pt_BR-faber-medium     CC0, male
#   ru  ru_RU-denis-medium     CC0, male (irina has no stated license)
#   tr  tr_TR-fettah-medium    CC0, male (Piper has no female Turkish voice)
# Per voice: language, path below the tag, SHA-256 of the model, SHA-256 of
# its config. Checksums from the download of 2026-10-14 (the model's is the LFS
# object id on Hugging Face): another file under the same address breaks the
# build instead of landing in the image silently.
ARG VOICE_BASE=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0
ARG PIPER_VOICES="\
de de/de_DE/kerstin/low/de_DE-kerstin-low d352a7641892cebf2903859af94e9ba81a141110215fe3943bcda7f7da401b7a 56e708556b7b9b7a53c4f8957e021421e69f11a600962bba554cffbe72cf2d47 \
en en/en_US/ljspeech/medium/en_US-ljspeech-medium 6f52a751e2349abe7a76735eb09dc1875298c77ea2342ffd2fef79ff81b87f22 141d612cc0a95ed7efc1ca936b845c2364967f2e9217c5dbfcf69fc4d6c65860 \
es es/es_ES/davefx/medium/es_ES-davefx-medium 6658b03b1a6c316ee4c265a9896abc1393353c2d9e1bca7d66c2c442e222a917 0e0dda87c732f6f38771ff274a6380d9252f327dca77aa2963d5fbdf9ec54842 \
fr fr/fr_FR/siwis/medium/fr_FR-siwis-medium 641d1ab097da2b81128c076810edb052b385decc8be3381814802a64a73baf99 39479916c2db192b5ac9764daddd0c744d83e023ad890c6976c0633ae4df8959 \
it it/it_IT/paola/medium/it_IT-paola-medium 6fc918b5a0ea6137382833dddfa567bffbe6a5060c02043c87192ee59c04210c aea19c0a7fce29fbc359b93f10e7902854401e4c95ae2ea328ae516b15d296cf \
nl nl/nl_BE/nathalie/medium/nl_BE-nathalie-medium 49cf48023861f9fd42e13a8632f068fee67d1ce244a6ee38f29595afbf0a6be4 4704af2736022e910a3f32672480d5530dd39da5c2bcc079f315f604166ff0de \
pl pl/pl_PL/gosia/medium/pl_PL-gosia-medium 38f66464240ed74f186e6b7dc13c6e3b22e023426299f25c2b3cc9dfa9373fbc 1aefb31a9d53ffe44a8163ff73ec833acb7a6253848f6bb0403d8a66f9c7510d \
pt pt/pt_BR/faber/medium/pt_BR-faber-medium 858555e3a064209c57088fe6bd70c4c3dc54d03eaa00c45d5ecaf43a33f95aa7 7e694de195ae3fc36dd732c445eb04fb49b649854893cb5506b978f0d50a1d6f \
ru ru/ru_RU/denis/medium/ru_RU-denis-medium 15fab56e11a097858ee115545d0f697fc2a316c41a291a5362349fb870411b0a 831c860dac0b5073eaa81610a0a638ec23d90a6cf8e5f871b4485c2cec3767c8 \
tr tr/tr_TR/fettah/medium/tr_TR-fettah-medium 5d14d5222f36aea2b8fc8dba097fcb18dcf8f5b33e5b2aa76b5e0b44602aa8d7 0738ecd770d4102fa967a784ae89f64d846b1b5f104076e410c978fefa70b3e7"
RUN set -e; mkdir /opt/voice; set -- $PIPER_VOICES; \
    while [ "$#" -ge 4 ]; do \
      python3 -c "import sys, urllib.request as u; u.urlretrieve(sys.argv[1] + '.onnx', sys.argv[2] + '.onnx'); u.urlretrieve(sys.argv[1] + '.onnx.json', sys.argv[2] + '.onnx.json')" "$VOICE_BASE/$2" "/opt/voice/$1"; \
      echo "$3  /opt/voice/$1.onnx" | sha256sum -c -; \
      echo "$4  /opt/voice/$1.onnx.json" | sha256sum -c -; \
      shift 4; \
    done; \
    [ "$#" -eq 0 ]
USER 65534:65534
WORKDIR /tmp
