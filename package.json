{
  "name": "serain",
  "version": "0.1.0",
  "description": "Personal AI agent over iMessage, self-hosted: mail, calendar, research and memory, with confirmation before anything that cannot be undone.",
  "license": "AGPL-3.0-only",
  "homepage": "https://serain.si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valewnrt/serain.git"
  },
  "keywords": [
    "agent",
    "assistant",
    "imessage",
    "claude",
    "self-hosted",
    "supabase",
    "personal-ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p web/client && tsc --noEmit -p site && tsc --noEmit -p site/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "FUZZ_RUNS=2000 vitest run test/fuzz",
    "memory:push": "tsx scripts/push-memory.ts",
    "memory:backfill-embeddings": "tsx scripts/backfill-embeddings.ts",
    "integration": "tsx scripts/integration.ts",
    "connector": "tsx scripts/connector.ts",
    "db:password": "tsx scripts/server.ts db-password",
    "browse:bench": "tsx scripts/browse-bench.ts",
    "eval": "tsx eval/cli.ts",
    "eval:rank": "tsx eval/cli.ts rank",
    "eval:export-chat": "tsx eval/export-chat.ts",
    "eval:memory": "tsx eval/memory/cli.ts",
    "eval:mail": "tsx eval/mail/cli.ts",
    "web:build": "tsx web/build.ts",
    "web:dev": "tsx web/dev.ts",
    "web": "tsx scripts/web.ts",
    "web:e2e": "tsx web/e2e/run.ts",
    "web:setup": "tsx scripts/web-cloudflare.ts setup",
    "web:deploy": "tsx scripts/web-cloudflare.ts deploy",
    "web:check": "tsx scripts/web-cloudflare.ts check",
    "site:build": "tsx site/build.ts",
    "site:dev": "tsx site/build.ts && wrangler dev -c site/wrangler.toml",
    "site:deploy": "tsx scripts/site-cloudflare.ts deploy",
    "site:check": "tsx scripts/site-cloudflare.ts check",
    "site:stats": "tsx scripts/site-cloudflare.ts stats"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1",
    "@supabase/supabase-js": "^2.58.0",
    "ai": "^7.0.105",
    "dotenv": "^17.2.3",
    "eld": "2.1.0",
    "ical.js": "2.2.1",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "tldts": "^7.4.18",
    "tsdav": "2.3.5",
    "tsx": "^4.20.6",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^8.0.2",
    "@types/opentype.js": "^1.3.10",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
